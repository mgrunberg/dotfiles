#!/bin/bash

echo "--> Linking config files"

ln -isTf $(readlink -f vim) ~/.vim

ln -isf $(readlink -f bash_aliases) ~/.bash_aliases
ln -isf $(readlink -f gemrc) ~/.gemrc
ln -isf $(readlink -f gitconfig) ~/.gitconfig
ln -isf $(readlink -f gitignore) ~/.gitignore
ln -isf $(readlink -f gvimrc) ~/.gvimrc
ln -isf $(readlink -f irbrc) ~/.irbrc
ln -isf $(readlink -f tmux.conf) ~/.tmux.conf
ln -isf $(readlink -f vimrc) ~/.vimrc
ln -isf $(readlink -f zshrc) ~/.zshrc

if [ ! -f "/etc/docker/daemon.json" ]; then
  echo "--> Creating docker daemon config file '/etc/docker/daemon.json'"
  sudo mkdir -p /etc/docker
  echo "{\"data-root\": \"$HOME/docker\", \"log-opts\": { \"max-file\": \"3\", \"max-size\": \"100m\" } }" | sudo tee -a "/etc/docker/daemon.json" > /dev/null
else
  echo "--> Docker daemon.json already exist, skipping."
fi


echo "--> Installing zsh plugins"

CURRENT_DIR=`pwd`
ZSH_PLUGINS_DIR="$HOME/.oh-my-zsh/custom/plugins"
mkdir -p "$ZSH_PLUGINS_DIR" && cd "$ZSH_PLUGINS_DIR"
if [ ! -d "$ZSH_PLUGINS_DIR/zsh-syntax-highlighting" ]; then
  echo "-----> Installing 'zsh-syntax-highlighting'"
  git clone https://github.com/zsh-users/zsh-autosuggestions
  git clone https://github.com/zsh-users/zsh-completions
  git clone https://github.com/zsh-users/zsh-syntax-highlighting
else
  echo "-----> 'zsh-syntax-highlighting' is already installed, skipping."
fi
cd "$CURRENT_DIR"


echo "--> Preparing tmux plugins"

if [ ! -d $HOME/.tmux/plugins/tpm ]; then
  echo "-----> Installing tmux plugin manager"
  git clone https://github.com/tmux-plugins/tpm $HOME/.tmux/plugins/tpm
  $HOME/.tmux/plugins/tpm/bin/install_plugins
fi

if ! command -v xclip >/dev/null 2>&1; then
  echo "-----> Installing xclip for tmux-yank"
  sudo apt install -y xclip
else
  echo "-----> xclip is already installed, skipping."
fi

if ! command -v wl-copy >/dev/null 2>&1; then
  echo "-----> Installing wl-clipboard for vim in wyland"
  sudo apt install -y wl-clipboard
else
  echo "-----> wl-clipboard is already installed, skipping."
fi


echo "--> Done!"

